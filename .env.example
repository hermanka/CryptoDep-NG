# ── Anthropic (default provider) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CRYPTODEP_ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Neo4j (optional — pipeline writes to SQLite by default) ──
NEO4J_URI=bolt://localhost:7687
NEO4J_PASSWORD=your_neo4j_password

# ── Ollama Cloud (https://ollama.com) ─────────────────────────
# CRYPTODEP_OLLAMA_MODEL=gemma4:31b-cloud
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_API_KEY=your_ollama_cloud_api_key

# ── Local Ollama (http://localhost:11434) ─────────────────────
# CRYPTODEP_OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_BASE_URL=http://localhost:11434

# ── OpenRouter ───────────────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-v1-...
# CRYPTODEP_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ── Groq ─────────────────────────────────────────────────────
# GROQ_API_KEY=gsk_...
# CRYPTODEP_GROQ_MODEL=llama-3.3-70b-versatile

# ── Active provider: anthropic | ollama | openrouter | groq ──
CRYPTODEP_LLM_PROVIDER=anthropic

# ── Debug ────────────────────────────────────────────────────
CRYPTODEP_DEBUG=0
# CRYPTODEP_SKIP_NEO4J=1  # uncomment if Docker/Neo4j is unavailable
